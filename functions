# Bash functions executed by MOS for the ai-template-maker plugin.
# See docs/Plugins/MOS-Plugin-Development-Guide.md: install/uninstall are
# called automatically; MOS is expected to run these with the extracted
# plugin directory as the working directory. Resolved defensively via
# BASH_SOURCE so this also works if that assumption doesn't hold — verify
# against the real MOS host (see plan step 6) and adjust if needed.

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
ANALYZE_SRC="${PLUGIN_DIR}/bin/ai-template-maker-analyze"
ANALYZE_DEST="/usr/bin/plugins/ai-template-maker-analyze"

install() {
  mkdir -p /usr/bin/plugins
  cp "$ANALYZE_SRC" "$ANALYZE_DEST"
  chmod 755 "$ANALYZE_DEST"
}

uninstall() {
  rm -f "$ANALYZE_DEST"
}

plugin_update() {
  install
}

mos_start() {
  # Re-assert the binary is in place after an OS/plugin restart, in case
  # /usr/bin/plugins was on non-persistent storage.
  [[ -f "$ANALYZE_DEST" ]] || install
}
