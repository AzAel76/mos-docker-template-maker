#!/usr/bin/env bash
# Invoked via MOS's synchronous plugin query endpoint:
#   POST /mos/plugins/query {command:"ai-template-maker-test-anthropic", args:[apiKey, model], parse_json:true}
# model is optional. Verifies the API key actually works and lists
# available models via GET /v1/models - used by the Settings tab's "Test
# connection" button for the Anthropic panel, mirroring
# ai-template-maker-test-ollama/-gemini. Unlike Ollama, Anthropic model IDs
# have no separate tag component, so matching is a plain exact check.
#
# Prints {"ok":true, "models":[...], "model_found":true|false|null} on
# success (model_found is null when no model arg was given), or
# {"ok":false, "error":"..."} on failure. Always exits 0.
set -uo pipefail

fail() {
  jq -n --arg msg "$1" '{ok:false, error:$msg}'
  exit 0
}

# See ai-template-maker-analyze's identical helper - guards against a
# stray leading/trailing space (easy via copy-paste) breaking the API key
# or an exact model-name match.
trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

command -v jq >/dev/null 2>&1 || fail "jq is required on the MOS host"
command -v curl >/dev/null 2>&1 || fail "curl is required on the MOS host"

api_key="$(trim "${1:-}")"
[[ -n "$api_key" ]] || fail "An Anthropic API key is required"
model="$(trim "${2:-}")"

response_file=$(mktemp)
http_status=$(curl -s --connect-timeout 5 --max-time 10 -o "$response_file" -w '%{http_code}' \
  -H "x-api-key: ${api_key}" -H "anthropic-version: 2023-06-01" \
  "https://api.anthropic.com/v1/models?limit=100")
curl_rc=$?
response=$(cat "$response_file" 2>/dev/null)
rm -f "$response_file"

[[ $curl_rc -eq 0 ]] || fail "Could not reach api.anthropic.com (curl exit ${curl_rc})"

if [[ "$http_status" != "200" ]]; then
  api_err=$(echo "$response" | jq -r '.error.message // empty' 2>/dev/null)
  if [[ "$http_status" == "401" ]]; then
    fail "Anthropic rejected this API key (HTTP 401)${api_err:+: ${api_err}}"
  fi
  fail "Anthropic returned HTTP ${http_status}${api_err:+: ${api_err}}"
fi

echo "$response" | jq empty 2>/dev/null || fail "Anthropic responded, but not with valid JSON"

models_json=$(echo "$response" | jq -c '[.data[]? | .id] | unique')

if [[ -n "$model" ]]; then
  model_found=$(echo "$response" | jq --arg m "$model" '[.data[]? | .id] | any(. == $m)')
else
  model_found="null"
fi

jq -n --argjson models "$models_json" --argjson found "$model_found" '{ok:true, models:$models, model_found:$found}'
