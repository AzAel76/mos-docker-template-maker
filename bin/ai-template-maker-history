#!/usr/bin/env bash
# Invoked via MOS's synchronous plugin query endpoint:
#   POST /mos/plugins/query {command:"ai-template-maker-history", args:[op, id], parse_json:true}
# op: "list" (default) - print the stored history array, newest first.
#     "clear" - reset history to an empty array, then print it.
#     "delete" - remove the single entry matching args[1] (its "id" field),
#       then print the updated array. Entries written before the "id" field
#       existed can't be targeted this way - "clear" is still the only way
#       to remove those.
# Must live at /usr/bin/plugins/ai-template-maker-history on the MOS host
# (installed there alongside ai-template-maker-analyze, which is what
# actually appends entries - see its log_history_success/log_history_failure).
#
# Always exits 0 and prints {"error":"..."} on failure, same convention as
# ai-template-maker-analyze (MOS's query executor discards stdout on a
# non-zero exit).
set -uo pipefail

PLUGIN_NAME="ai-template-maker"

fail() {
  jq -n --arg msg "$1" '{error:$msg}'
  exit 0
}

command -v jq >/dev/null 2>&1 || fail "jq is required on the MOS host"

# Same resolution as ai-template-maker-analyze (which is what actually
# writes this file) - must match exactly, or this script would be looking
# in the wrong place for what that one wrote. See its DATA_DIR comment for
# why this isn't just /boot/optional/plugins/<name> unconditionally: that
# path is the USB boot device MOS loads into RAM, meant for occasional
# config writes, not a file rewritten on every analysis.
plugin_data_pool=$(jq -r '.appdata // empty' /boot/config/docker.json 2>/dev/null)
if [[ -n "$plugin_data_pool" ]]; then
  DATA_DIR="${plugin_data_pool%/}/${PLUGIN_NAME}"
else
  DATA_DIR="/boot/optional/plugins/${PLUGIN_NAME}"
fi
HISTORY_FILE="${DATA_DIR}/history.json"

op="${1:-list}"

case "$op" in
  list)
    if [[ -f "$HISTORY_FILE" ]]; then
      jq -c '.' "$HISTORY_FILE" 2>/dev/null || echo '[]'
    else
      echo '[]'
    fi
    ;;
  clear)
    mkdir -p "$(dirname "$HISTORY_FILE")" 2>/dev/null || fail "Could not create plugin data directory"
    echo '[]' > "$HISTORY_FILE" 2>/dev/null || fail "Could not clear history file"
    echo '[]'
    ;;
  delete)
    entry_id="${2:-}"
    [[ -n "$entry_id" ]] || fail "An entry id is required"
    [[ -f "$HISTORY_FILE" ]] || { echo '[]'; exit 0; }
    (
      flock -w 5 -x 200 || fail "Could not lock the history file"
      current=$(cat "$HISTORY_FILE" 2>/dev/null)
      jq empty <<<"$current" >/dev/null 2>&1 || current='[]'
      updated=$(jq --arg id "$entry_id" '[.[] | select(.id != $id)]' <<<"$current" 2>/dev/null)
      if [[ -n "$updated" ]]; then
        echo "$updated" > "$HISTORY_FILE"
        echo "$updated"
      else
        echo "$current"
      fi
    ) 200>"${HISTORY_FILE}.lock"
    ;;
  *)
    fail "Unknown operation '${op}' (expected 'list', 'clear', or 'delete')"
    ;;
esac
