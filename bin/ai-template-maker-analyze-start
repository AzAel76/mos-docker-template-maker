#!/usr/bin/env bash
# Invoked via MOS's synchronous plugin query endpoint:
#   POST /mos/plugins/query {command:"ai-template-maker-analyze-start", args:[repoUrl, scope], parse_json:true}
#
# Kicks off the real analysis (ai-template-maker-analyze - unchanged,
# still directly runnable for manual testing) as a detached background
# process and returns {"job_id":"..."} immediately. Exists because
# ai-template-maker-analyze can comfortably exceed MOS's 60-second
# synchronous query ceiling (seen in practice on Ollama with a modest
# model/no GPU) and there is no way to raise that ceiling - MOS clamps
# query timeouts to 60s both client- and server-side, and its only other
# execution primitive (/mos/plugins/executefunction) is fire-and-forget
# with no way to return a result to the caller. Poll
# ai-template-maker-analyze-status with the returned job id instead.
#
# Must live at /usr/bin/plugins/ai-template-maker-analyze-start on the
# MOS host, alongside ai-template-maker-analyze itself.
set -uo pipefail

PLUGIN_NAME="ai-template-maker"
ANALYZE_BIN="/usr/bin/plugins/${PLUGIN_NAME}-analyze"

fail() {
  jq -n --arg msg "$1" '{error:$msg}'
  exit 0
}

command -v jq >/dev/null 2>&1 || fail "jq is required on the MOS host"
[[ -x "$ANALYZE_BIN" ]] || fail "${ANALYZE_BIN} not found or not executable"

# MOS boots from a USB drive into RAM and only writes back to that same
# USB for things meant to persist across reboots - limited write
# endurance, meant for occasional config writes, not the handful of small
# files this creates/updates on every single analysis. Prefer the real
# storage pool instead (same /boot/config/docker.json .appdata setting
# ai-template-maker-analyze's own remap_appdata_paths() resolves docker
# host paths against), falling back to the boot-resident plugin directory
# only if no pool is configured yet.
plugin_data_pool=$(jq -r '.appdata // empty' /boot/config/docker.json 2>/dev/null)
if [[ -n "$plugin_data_pool" ]]; then
  DATA_DIR="${plugin_data_pool%/}/${PLUGIN_NAME}"
else
  DATA_DIR="/boot/optional/plugins/${PLUGIN_NAME}"
fi
JOBS_DIR="${DATA_DIR}/jobs"

repo_url="${1:-}"
[[ -n "$repo_url" ]] || fail "A repository URL is required"
scope="${2:-required}"

mkdir -p "$JOBS_DIR" 2>/dev/null || fail "Could not create the plugin's jobs directory"

# Prune job directories older than 6 hours so this never grows unbounded.
# This used to be 60 minutes, back when the frontend gave up watching after
# 10 - but a legitimate slow-hardware Ollama run can now take up to an hour
# (see mosClient.analyzeRepo's maxWaitMs) with no intermediate writes to its
# own job dir in between, so a 60-minute prune could have deleted a job's
# directory out from under it mid-run if a second analysis happened to
# start while the first was still going. 6 hours gives generous headroom
# above the longest a client will ever wait, while still eventually
# cleaning up dirs that were genuinely abandoned. Missing dirs are handled
# gracefully anyway - ai-template-maker-analyze-status treats one as
# "unknown job" rather than erroring.
find "$JOBS_DIR" -mindepth 1 -maxdepth 1 -type d -mmin +360 -exec rm -rf {} + 2>/dev/null

job_id="$(date +%s%N)_$$"
job_dir="${JOBS_DIR}/${job_id}"
mkdir -p "$job_dir" || fail "Could not create job directory"
echo "running" > "$job_dir/status"

# setsid gives the job its own process group (PGID == its own PID), and
# that PID is recorded so ai-template-maker-analyze-cancel can later kill
# the *whole* group (the analyze script plus whatever curl/etc. it has
# spawned) with one `kill -- -PID`, not just the top-level process leaving
# orphaned children behind. Detaching stdin/stdout/stderr from /dev/null
# and files (rather than inheriting this script's) is still required
# regardless: MOS's query executor (Node's child_process.exec) only
# considers this command finished once those file descriptors reach EOF,
# which won't happen while a backgrounded child still holds a copy open -
# even after this script's own foreground part has exited.
setsid bash -c '
  # ai-template-maker-analyze-cancel writes "cancelled" to the status file
  # *before* signaling this process, specifically so that a narrow race -
  # the job finishing (successfully or not) in the instant between that
  # write and the kill signal actually landing - cannot clobber it back to
  # "done"/"error" once the caller has already been told it was cancelled.
  if "$1" "$2" "$3" > "$4/result.json.tmp" 2>"$4/error.log"; then
    if [[ "$(cat "$4/status" 2>/dev/null)" != "cancelled" ]]; then
      mv "$4/result.json.tmp" "$4/result.json"
      echo "done" > "$4/status"
    fi
  else
    [[ "$(cat "$4/status" 2>/dev/null)" == "cancelled" ]] || echo "error" > "$4/status"
  fi
' _ "$ANALYZE_BIN" "$repo_url" "$scope" "$job_dir" < /dev/null > /dev/null 2>&1 &
job_pid=$!
disown
echo "$job_pid" > "$job_dir/pid"

jq -n --arg id "$job_id" '{job_id: $id}'
