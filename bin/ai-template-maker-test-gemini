#!/usr/bin/env bash
# Invoked via MOS's synchronous plugin query endpoint:
#   POST /mos/plugins/query {command:"ai-template-maker-test-gemini", args:[apiKey, model], parse_json:true}
# model is optional. Verifies the API key actually works and lists
# available models via GET /v1beta/models - used by the Settings tab's
# "Test connection" button for the Gemini panel, mirroring
# ai-template-maker-test-ollama/-anthropic.
#
# Prints {"ok":true, "models":[...], "model_found":true|false|null} on
# success (model_found is null when no model arg was given), or
# {"ok":false, "error":"..."} on failure. Always exits 0.
set -uo pipefail

fail() {
  jq -n --arg msg "$1" '{ok:false, error:$msg}'
  exit 0
}

# See ai-template-maker-analyze's identical helper - guards against a
# stray leading/trailing space (easy via copy-paste) breaking the API key
# or an exact model-name match.
trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

command -v jq >/dev/null 2>&1 || fail "jq is required on the MOS host"
command -v curl >/dev/null 2>&1 || fail "curl is required on the MOS host"

api_key="$(trim "${1:-}")"
[[ -n "$api_key" ]] || fail "A Gemini API key is required"
model="$(trim "${2:-}")"

response_file=$(mktemp)
http_status=$(curl -s --connect-timeout 5 --max-time 10 -o "$response_file" -w '%{http_code}' \
  "https://generativelanguage.googleapis.com/v1beta/models?pageSize=200&key=${api_key}")
curl_rc=$?
response=$(cat "$response_file" 2>/dev/null)
rm -f "$response_file"

[[ $curl_rc -eq 0 ]] || fail "Could not reach generativelanguage.googleapis.com (curl exit ${curl_rc})"

if [[ "$http_status" != "200" ]]; then
  api_err=$(echo "$response" | jq -r '.error.message // empty' 2>/dev/null)
  if [[ "$http_status" == "400" || "$http_status" == "403" ]]; then
    fail "Gemini rejected this API key (HTTP ${http_status})${api_err:+: ${api_err}}"
  fi
  fail "Gemini returned HTTP ${http_status}${api_err:+: ${api_err}}"
fi

echo "$response" | jq empty 2>/dev/null || fail "Gemini responded, but not with valid JSON"

# Model names come back as "models/gemini-2.5-flash" - strip the prefix to
# match how this plugin references models everywhere else (settings.json,
# the model field, etc. all use the bare name).
models_json=$(echo "$response" | jq -c '[.models[]? | (.name // "") | sub("^models/"; "")] | map(select(. != "")) | unique')

if [[ -n "$model" ]]; then
  model_found=$(echo "$response" | jq --arg m "$model" '
    [.models[]? | (.name // "") | sub("^models/"; "")] | any(. == $m)
  ')
else
  model_found="null"
fi

jq -n --argjson models "$models_json" --argjson found "$model_found" '{ok:true, models:$models, model_found:$found}'
