#!/usr/bin/env bash
# Invoked via MOS's synchronous plugin query endpoint:
#   POST /mos/plugins/query {command:"ai-template-maker-analyze", args:[repoUrl, scope], parse_json:true}
#   scope is "all" (default - every setting found, comprehensive) or
#   "required" (only what's needed for the app to run).
# Must live at /usr/bin/plugins/ai-template-maker-analyze on the MOS host
# (installed there by the plugin's `functions` install() hook).
#
# Prints one JSON object to stdout:
#   {"mode":"docker","docker":{...MOS docker.json shape...}}
#   {"mode":"compose","name":"...","yaml":"...","env":"...","template":{...}}
# On failure, prints {"error":"..."} to stdout.
#
# IMPORTANT: always exit 0. MOS's query executor (plugins.service.js
# executeQuery) only returns stdout as `output` when the command exits 0 -
# on a non-zero exit it discards stdout and substitutes stderr/a generic
# "Command failed" message instead, silently swallowing our real error
# text. So every failure path here still prints {"error": "..."} to
# stdout and exits 0; the frontend distinguishes success from failure by
# checking for an "error" key in the parsed output, not by HTTP/exit status.
set -uo pipefail

PLUGIN_NAME="ai-template-maker"
SETTINGS_FILE="/boot/optional/plugins/${PLUGIN_NAME}/settings.json"

fail() {
  jq -n --arg msg "$1" '{error:$msg}'
  exit 0
}

command -v jq >/dev/null 2>&1 || { echo '{"error":"jq is required on the MOS host"}'; exit 0; }
command -v curl >/dev/null 2>&1 || { echo '{"error":"curl is required on the MOS host"}'; exit 0; }

repo_url="${1:-}"
[[ -n "$repo_url" ]] || fail "A repository URL is required"

scope="${2:-all}"
case "$scope" in
  all|required) ;;
  *) fail "Invalid scope '${scope}' (expected 'all' or 'required')" ;;
esac

# ---------------------------------------------------------------------------
# Settings: env vars win (used for standalone/manual testing), then
# settings.json written by the plugin's Settings tab.
# ---------------------------------------------------------------------------
provider="${MOS_TEMPLATE_MAKER_PROVIDER:-}"
api_key="${ANTHROPIC_API_KEY:-${GEMINI_API_KEY:-}}"
model="${MOS_TEMPLATE_MAKER_MODEL:-}"
github_token="${GITHUB_TOKEN:-}"
ollama_host="${OLLAMA_HOST:-}"

if [[ -f "$SETTINGS_FILE" ]]; then
  [[ -z "$provider" ]] && provider=$(jq -r '.provider // empty' "$SETTINGS_FILE" 2>/dev/null)
  [[ -z "$api_key" ]] && api_key=$(jq -r '.api_key // empty' "$SETTINGS_FILE" 2>/dev/null)
  [[ -z "$model" ]] && model=$(jq -r '.model // empty' "$SETTINGS_FILE" 2>/dev/null)
  [[ -z "$github_token" ]] && github_token=$(jq -r '.github_token // empty' "$SETTINGS_FILE" 2>/dev/null)
  [[ -z "$ollama_host" ]] && ollama_host=$(jq -r '.ollama_host // empty' "$SETTINGS_FILE" 2>/dev/null)
fi
provider="${provider:-anthropic}"

case "$provider" in
  anthropic) model="${model:-claude-sonnet-5}" ;;
  gemini)    model="${model:-gemini-2.5-flash}" ;;
  ollama)    model="${model:-llama3.1}"; ollama_host="${ollama_host:-http://localhost:11434}" ;;
  *) fail "Unknown provider '${provider}' (expected anthropic, gemini, or ollama)" ;;
esac

if [[ "$provider" != "ollama" ]]; then
  [[ -n "$api_key" ]] || fail "No API key configured for ${provider}. Set it in the plugin's Settings tab."
fi

# ---------------------------------------------------------------------------
# Parse owner/repo out of the given URL.
# ---------------------------------------------------------------------------
owner_repo=$(echo "$repo_url" | sed -E 's#^https?://(www\.)?github\.com/([^/]+/[^/]+?)(\.git)?/?$#\2#')
[[ "$owner_repo" != "$repo_url" && "$owner_repo" == */* ]] || fail "Could not parse a GitHub owner/repo from: $repo_url"

gh_auth=()
[[ -n "$github_token" ]] && gh_auth=(-H "Authorization: Bearer $github_token")

gh_api() { curl -sf "${gh_auth[@]}" -H "Accept: application/vnd.github+json" "$@"; }
gh_raw_file() { curl -sf "${gh_auth[@]}" "https://raw.githubusercontent.com/${owner_repo}/${default_branch}/$1" 2>/dev/null; }
# READMEs and env-var docs routinely run 30-50KB on well-documented repos
# (the whole point of this tool); truncating at a few KB silently drops the
# actual docker-run/.env sections. Budget generously - Claude's context
# window comfortably fits this.
trunc() { head -c 60000; }

repo_meta=$(gh_api "https://api.github.com/repos/${owner_repo}") || fail "GitHub repo not found or inaccessible: ${owner_repo}"
default_branch=$(echo "$repo_meta" | jq -r '.default_branch // "main"')

# Full recursive tree, not just the root listing - Dockerfiles, compose
# files, and .env examples are routinely nested (docker/, example/, deploy/).
repo_tree=$(gh_api "https://api.github.com/repos/${owner_repo}/git/trees/${default_branch}?recursive=1" | jq -r '.tree[]? | select(.type=="blob") | .path' 2>/dev/null)
find_file() {
  # $1 = case-insensitive regex; prefers the shallowest path, then shortest.
  echo "$repo_tree" | grep -iE "$1" | awk '{print gsub(/\//,"/"), length, $0}' | sort -n | head -1 | cut -d' ' -f3-
}

repo_slug="${owner_repo##*/}"
compose_candidates=$(echo "$repo_tree" | grep -iE '(^|/)(docker-)?compose\.ya?ml$')
# Repos with multiple example stacks (e.g. example/<app>/, example/smtp/,
# example/traefik/) can have several compose.yaml files - prefer the one
# whose path actually names this app over an unrelated sidecar example.
compose_path=$(echo "$compose_candidates" | grep -iF "$repo_slug" | head -1)
if [[ -z "$compose_path" ]]; then
  compose_path=$(echo "$compose_candidates" | awk '{print gsub(/\//,"/"), length, $0}' | sort -n | head -1 | cut -d' ' -f3-)
fi
dockerfile_path=$(find_file '(^|/)dockerfile$')
# Prefer a documented example (.env.example/.env.sample) over a real .env,
# since a real .env in a repo (rare, but possible) may hold live secrets.
env_path=$(find_file '(^|/)\.env\.(example|sample)$')
[[ -n "$env_path" ]] || env_path=$(find_file '(^|/)\.env$')

readme_t=$(gh_api -H "Accept: application/vnd.github.raw" "https://api.github.com/repos/${owner_repo}/readme" 2>/dev/null | trunc)
compose_t=""
[[ -n "$compose_path" ]] && compose_t=$(gh_raw_file "$compose_path" | trunc)
dockerfile_t=""
[[ -n "$dockerfile_path" ]] && dockerfile_t=$(gh_raw_file "$dockerfile_path" | trunc)
env_t=""
[[ -n "$env_path" ]] && env_t=$(gh_raw_file "$env_path" | trunc)

[[ -n "$readme_t$compose_t$dockerfile_t$env_t" ]] || fail "No README, Dockerfile, compose file, or .env example found in ${owner_repo}"

# ---------------------------------------------------------------------------
# Few-shot schema examples, baked into the script (only this file is copied
# onto the MOS host, so it can't read the repo's samples/ dir at runtime).
# ---------------------------------------------------------------------------
docker_schema_example=$(cat <<'EOF'
{
  "name": "Jellyfin",
  "repo": "lscr.io/linuxserver/jellyfin:latest",
  "network": "bridge",
  "extra_parameters": "--restart=unless-stopped",
  "web_ui_url": "http://[IP]:[PORT:8096]/",
  "icon": "",
  "description": "Media server for streaming your library.",
  "paths": [
    { "name": "Data Path", "mode": "", "host": "/mnt/cache/AppData/jellyfin/config", "container": "/config", "description": "" }
  ],
  "ports": [
    { "name": "http - WebGUI", "protocol": "tcp", "host": "8096", "container": "8096", "description": "" }
  ],
  "variables": [
    { "name": "PUID", "key": "PUID", "value": "500", "mask": false, "description": "" }
  ],
  "devices": [],
  "labels": [],
  "no_autoupdate": false,
  "privileged": false
}
EOF
)

compose_schema_example=$(cat <<'EOF'
{
  "mode": "compose",
  "name": "immich",
  "yaml": "services:\n  immich-server:\n    image: ghcr.io/immich-app/immich-server:release\n    ports:\n      - \"2283:2283\"\n    volumes:\n      - /mnt/cache/appdata/immich/upload:/usr/src/app/upload\n  immich-redis:\n    image: redis:6.2-alpine\n",
  "env": "TZ=UTC\nDB_PASSWORD=changeme\n",
  "template": {
    "name": "Immich",
    "description": "Self-hosted photo and video backup solution.",
    "icon": "",
    "webui": "http://{IP}:2283",
    "category": ["Media"]
  }
}
EOF
)

# ---------------------------------------------------------------------------
# Ask Claude to produce one strict-JSON object matching one of the two shapes
# above. Whether this is a single-container ("docker") or multi-service
# ("compose") app is Claude's call, based on the actual services it sees.
# ---------------------------------------------------------------------------
if [[ "$scope" == "required" ]]; then
  scope_purpose="The point of this template is to let someone get this
self-hosted service running with the least amount of setup: it should
include only what the app actually needs to start - required variables,
its essential config/data paths, its main service port(s) - and leave out
everything optional or advanced, even if the docs mention it."
  scope_rule="- Include ONLY variables/paths/ports that are required for the
  app to run: the docs mark them Required, or the app has no usable default
  and won't start without them. Omit optional/advanced ones entirely - the
  goal here is the smallest working template, not an exhaustive one. A
  short list is correct here; don't pad it out with anything the app can
  run without."
else
  scope_purpose="The point of this template is to let someone try out a new
self-hosted service without typing or copy-pasting config by hand: it
should arrive with every setting they might plausibly need already present
(with a sensible default, or blank with a description) so they only ever
have to delete what they don't want, never hunt down and add something
that's missing."
  scope_rule="- Include every variable you find - optional/advanced ones
  included. Do NOT prune down to a \"required only\" subset; a long list
  the user can delete from is correct, a short list they'd have to add to
  is not."
fi

system_prompt=$(cat <<EOF
You turn a software project's install docs into a MOS (mos-official.net) app
template. ${scope_purpose} MOS templates come in two shapes:

1) "docker" mode - for a single-container app (a plain \`docker run\`, or a
   compose file with exactly one service). Output shape (see example):
${docker_schema_example}

2) "compose" mode - for a multi-service app (a compose file with 2+
   services that must run together). Output shape (see example):
${compose_schema_example}

Rules:
- "name" ("docker.name" in docker mode, top-level "name" in compose mode)
  is a literal Docker container/stack identifier, not a display title -
  Docker rejects anything outside [a-zA-Z0-9][a-zA-Z0-9_.-]*. Use a
  lowercase-hyphenated slug of the app's name (e.g. "github-release-monitor",
  not "GitHub Release Monitor"). In compose mode this is separate from
  "template.name", which is the human-readable display title and can keep
  spaces/capitalization normally.
- Prefer "docker" mode whenever the app only truly needs one container to
  run standalone. If the repo documents more than one deployment method
  (e.g. a plain \`docker run\` AND a docker-compose example that adds a
  reverse proxy, external networks, or optional sidecar containers like a
  mailer), prefer the simplest self-contained one - don't drag in
  infrastructure that isn't required just because a compose example
  showed it as an option.
- If a \`docker run\` command uses \`--env-file\`, the actual environment
  variables are NOT in that command - they're in the .env/.env.example
  file provided below (if any). Treat that file as the authoritative
  variable list: one \`variables\` entry per key found in it. Use the
  comment immediately above each key as its "description", and its
  example/default value as "value" (blank placeholders like "" or
  "changeme" stay blank/placeholder - don't invent a real-looking secret).
${scope_rule}
- Set "mask": true for any variable that is a password, token, secret, or
  API key.
- Note in each such variable's description when the README marks it
  Required vs optional, and any stated constraints (e.g. "min 32 chars").
- Use real values from the provided README/Dockerfile/compose/env
  content: the actual image tag, actual ports, actual volumes/paths.
  Do not invent ports or paths that aren't evidenced in the input.
- Use MOS's standard host path convention: /mnt/cache/appdata/<app>/<name>
  for any path you must invent (e.g. a config volume with no host path
  specified upstream).
- web_ui_url / webui must use the literal placeholder tokens shown in the
  examples ([IP], [PORT:xxxx], {IP}) - do not guess a real IP. Use the
  container port (not the example host port) in [PORT:xxxx].
- Leave "icon" as an empty string - it is resolved separately.
- Respond with ONLY the single JSON object. No markdown fences, no prose.
EOF
)

user_content=$(cat <<EOF
Repository: ${owner_repo}

README (may be truncated):
${readme_t}

Dockerfile (may be truncated, may be absent):
${dockerfile_t}

Compose file (may be truncated, may be absent):
${compose_t}

.env / .env.example file (may be truncated, may be absent - authoritative
source of environment variables when a docker run command uses --env-file):
${env_t}
EOF
)

# Each provider fills the shared $raw_text with the model's answer (a JSON
# string, possibly fenced) and fail()s itself on any error/truncation.
budget=8192

# claude-sonnet-5 runs adaptive extended thinking by default, which prepends
# a "thinking" content block before the "text" block - max_tokens covers
# both, and content[0] is the thinking block, not the answer. Request
# medium effort (this is single-shot extraction, not agentic reasoning -
# doesn't need "high") and budget enough tokens for both a real thinking
# pass and a large, comprehensive template (36+ variables is normal - see
# the comprehensiveness rule above), well within MOS's 60s query timeout.
call_anthropic() {
  local request_body response stop_reason
  request_body=$(jq -n \
    --arg model "$model" --argjson budget "$budget" \
    --arg system "$system_prompt" --arg user "$user_content" \
    '{
      model: $model,
      max_tokens: $budget,
      thinking: {type: "adaptive"},
      output_config: {effort: "medium"},
      system: $system,
      messages: [{role:"user", content:$user}]
    }')

  response=$(curl -sf \
    -H "x-api-key: ${api_key}" \
    -H "anthropic-version: 2023-06-01" \
    -H "content-type: application/json" \
    -d "$request_body" \
    "https://api.anthropic.com/v1/messages") || fail "Claude API request failed"

  stop_reason=$(echo "$response" | jq -r '.stop_reason // empty')
  # Content is an array of typed blocks (thinking, text, ...) - find the text
  # block instead of assuming index 0.
  raw_text=$(echo "$response" | jq -r '[.content[]? | select(.type == "text") | .text] | join("")')
  [[ -n "$raw_text" ]] || fail "Claude returned no content (stop_reason: ${stop_reason:-unknown}): $(echo "$response" | jq -c '.error // .' 2>/dev/null)"
  [[ "$stop_reason" != "max_tokens" ]] || fail "Claude's response was truncated (hit the token limit) before finishing the template"
}

# Gemini's free API tier - responseMimeType forces strict JSON, so no
# fence-stripping is needed for this path (harmless if it stays anyway).
call_gemini() {
  local request_body response finish_reason
  request_body=$(jq -n \
    --argjson budget "$budget" \
    --arg system "$system_prompt" --arg user "$user_content" \
    '{
      system_instruction: {parts: [{text: $system}]},
      contents: [{role: "user", parts: [{text: $user}]}],
      generationConfig: {responseMimeType: "application/json", maxOutputTokens: $budget}
    }')

  response=$(curl -sf \
    -H "content-type: application/json" \
    -d "$request_body" \
    "https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${api_key}") \
    || fail "Gemini API request failed"

  finish_reason=$(echo "$response" | jq -r '.candidates[0].finishReason // empty')
  raw_text=$(echo "$response" | jq -r '.candidates[0].content.parts[0].text // empty')
  [[ -n "$raw_text" ]] || fail "Gemini returned no content (finishReason: ${finish_reason:-unknown}): $(echo "$response" | jq -c '.error // .' 2>/dev/null)"
  [[ "$finish_reason" != "MAX_TOKENS" ]] || fail "Gemini's response was truncated (hit the token limit) before finishing the template"
}

# Local model via Ollama - no API key, but no vendor safety net either:
# small local models are noticeably less reliable at holding this whole
# schema together than Claude/Gemini, and there's no billing wall to hide
# a slow first-token cold start behind MOS's 60s query timeout.
call_ollama() {
  local request_body response
  request_body=$(jq -n \
    --arg model "$model" \
    --arg system "$system_prompt" --arg user "$user_content" \
    '{
      model: $model,
      stream: false,
      format: "json",
      messages: [{role:"system", content:$system}, {role:"user", content:$user}]
    }')

  response=$(curl -sf \
    -H "content-type: application/json" \
    -d "$request_body" \
    "${ollama_host%/}/api/chat") \
    || fail "Could not reach Ollama at ${ollama_host} - is it running and reachable from the MOS host?"

  raw_text=$(echo "$response" | jq -r '.message.content // empty')
  [[ -n "$raw_text" ]] || fail "Ollama returned no content: $(echo "$response" | jq -c '.error // .' 2>/dev/null)"
}

case "$provider" in
  anthropic) call_anthropic ;;
  gemini)    call_gemini ;;
  ollama)    call_ollama ;;
esac

# Strip stray markdown fences if the model added them despite instructions.
json_text=$(echo "$raw_text" | sed -E '/^```/d')

echo "$json_text" | jq empty 2>/dev/null || fail "Claude did not return valid JSON"

# ---------------------------------------------------------------------------
# Icon resolution: selfh.st/icons, then dashboard-icons, by slugified name.
# ---------------------------------------------------------------------------
slugify() { echo "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'; }

resolve_icon() {
  local slug
  slug=$(slugify "$1")
  [[ -n "$slug" ]] || return 0
  local candidates=(
    "https://cdn.jsdelivr.net/gh/selfhst/icons@main/png/${slug}.png"
    "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons@main/png/${slug}.png"
  )
  local url
  for url in "${candidates[@]}"; do
    if curl -sfIL --max-time 5 "$url" >/dev/null 2>&1; then
      echo "$url"
      return 0
    fi
  done
}

# Docker container/stack names must match [a-zA-Z0-9][a-zA-Z0-9_.-]* - the
# system prompt tells the model this, but don't rely on it complying (seen in
# practice: "GitHub Release Monitor" instead of "github-release-monitor",
# which the Docker daemon rejects outright at creation time). slugify()
# already produces a safe charset; just guard against an all-symbols input
# collapsing to an empty/invalid string.
sanitize_name() {
  local slug
  slug=$(slugify "$1")
  echo "${slug:-app}"
}

mode=$(echo "$json_text" | jq -r '.mode // "docker"')
if [[ "$mode" == "compose" ]]; then
  raw_name=$(echo "$json_text" | jq -r '.name // "app"')
  safe_name=$(sanitize_name "$raw_name")
  json_text=$(echo "$json_text" | jq --arg name "$safe_name" '.name = $name')
  app_name=$(echo "$json_text" | jq -r '.template.name // .name')
  icon_url=$(resolve_icon "$app_name")
  echo "$json_text" | jq --arg icon "${icon_url:-}" '.template.icon = $icon'
else
  # Wrap bare docker-shaped output for consistency, in case the model
  # omitted the {"mode":"docker","docker":{...}} envelope.
  has_docker_key=$(echo "$json_text" | jq 'has("docker")')
  if [[ "$has_docker_key" != "true" ]]; then
    json_text=$(jq -n --argjson d "$json_text" '{mode:"docker", docker:$d}')
  fi
  raw_name=$(echo "$json_text" | jq -r '.docker.name // "app"')
  safe_name=$(sanitize_name "$raw_name")
  json_text=$(echo "$json_text" | jq --arg name "$safe_name" '.docker.name = $name')
  app_name=$(echo "$json_text" | jq -r '.docker.name')
  icon_url=$(resolve_icon "$app_name")
  echo "$json_text" | jq --arg icon "${icon_url:-}" '.docker.icon = $icon'
fi
