#!/usr/bin/env bash
# Invoked via MOS's synchronous plugin query endpoint:
#   POST /mos/plugins/query {command:"ai-template-maker-analyze", args:[repoUrl, scope], parse_json:true}
#   scope is "required" (default - only what's needed for the app to run) or
#   "all" (every setting found, comprehensive).
# Must live at /usr/bin/plugins/ai-template-maker-analyze on the MOS host
# (installed there by the plugin's `functions` install() hook).
#
# Prints one JSON object to stdout:
#   {"mode":"docker","docker":{...MOS docker.json shape...}}
#   {"mode":"compose","name":"...","yaml":"...","env":"...","template":{...}}
# On failure, prints {"error":"..."} to stdout.
#
# IMPORTANT: always exit 0. MOS's query executor (plugins.service.js
# executeQuery) only returns stdout as `output` when the command exits 0 -
# on a non-zero exit it discards stdout and substitutes stderr/a generic
# "Command failed" message instead, silently swallowing our real error
# text. So every failure path here still prints {"error": "..."} to
# stdout and exits 0; the frontend distinguishes success from failure by
# checking for an "error" key in the parsed output, not by HTTP/exit status.
set -uo pipefail

PLUGIN_NAME="ai-template-maker"
# settings.json's location is dictated by MOS's own plugin settings API
# (we write it via POST /mos/plugins/settings/<name>, not directly), and
# that's boot-USB-resident - fine, since it's only written on an explicit
# Settings-tab Save, same low frequency as any of MOS's own config. What
# we DO control is where history.json and the jobs/ directory live, and
# those get written far more often (every single analysis) - see DATA_DIR
# below for why they don't default to sharing that same boot-resident path.
SETTINGS_FILE="/boot/optional/plugins/${PLUGIN_NAME}/settings.json"

fail() {
  jq -n --arg msg "$1" '{error:$msg}'
  exit 0
}

# Pure-bash whitespace trim (no jq-version or external-tool dependency) -
# applied to every value pulled from settings.json below, since a stray
# leading/trailing space (easy to introduce via copy-paste into the
# Settings tab) would otherwise silently break an exact/prefix match, e.g.
# against Ollama's pulled-model list.
trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

command -v jq >/dev/null 2>&1 || { echo '{"error":"jq is required on the MOS host"}'; exit 0; }
command -v curl >/dev/null 2>&1 || { echo '{"error":"curl is required on the MOS host"}'; exit 0; }

# MOS boots this whole system from a USB drive into RAM and only writes
# back to that same USB for things meant to persist across reboots -
# limited write endurance, meant for occasional config writes, not a file
# rewritten on every single analysis. /boot/config/docker.json's .appdata
# is the real storage-pool location remap_appdata_paths() below already
# resolves docker host paths against; reused here for the same reason, on
# the same pool, with the boot-resident path only as a fallback for a box
# with no pool configured yet (e.g. before initial setup).
plugin_data_pool=$(jq -r '.appdata // empty' /boot/config/docker.json 2>/dev/null)
if [[ -n "$plugin_data_pool" ]]; then
  DATA_DIR="${plugin_data_pool%/}/${PLUGIN_NAME}"
else
  DATA_DIR="/boot/optional/plugins/${PLUGIN_NAME}"
fi
HISTORY_FILE="${DATA_DIR}/history.json"

repo_url="${1:-}"
[[ -n "$repo_url" ]] || fail "A repository URL is required"
# Strip a trailing query string/fragment (e.g. "?ref=selfh.st" from a
# selfh.st referral link, or a "#readme" anchor) before parsing. Without
# this, the owner/repo regex below has no "/" to stop the repo-name
# capture group at, so it swallows the whole thing - "ytzero?ref=selfh.st"
# becomes the "repo name", which then leaks into the docker/stack name,
# the OCI source label, and the history entry.
repo_url="${repo_url%%\?*}"
repo_url="${repo_url%%#*}"

scope="${2:-required}"
case "$scope" in
  all|required) ;;
  *) fail "Invalid scope '${scope}' (expected 'all' or 'required')" ;;
esac

# ---------------------------------------------------------------------------
# Settings: env vars win (used for standalone/manual testing), then
# settings.json written by the plugin's Settings tab. Each provider keeps
# its own config block (settings.json: {provider, anthropic:{...},
# gemini:{...}, ollama:{...}, openai:{...}, github_token}) so switching the
# default provider doesn't clobber the other providers' saved keys.
# ---------------------------------------------------------------------------
provider="${MOS_TEMPLATE_MAKER_PROVIDER:-}"
api_key="${ANTHROPIC_API_KEY:-${GEMINI_API_KEY:-${OPENAI_API_KEY:-}}}"
model="${MOS_TEMPLATE_MAKER_MODEL:-}"
github_token="${GITHUB_TOKEN:-}"
ollama_host="${OLLAMA_HOST:-}"
openai_base_url="${OPENAI_BASE_URL:-}"

if [[ -f "$SETTINGS_FILE" ]]; then
  [[ -z "$provider" ]] && provider=$(jq -r '.provider // empty' "$SETTINGS_FILE" 2>/dev/null)
  [[ -z "$github_token" ]] && github_token=$(jq -r '.github_token // empty' "$SETTINGS_FILE" 2>/dev/null)
fi
provider="${provider:-anthropic}"

if [[ -f "$SETTINGS_FILE" ]]; then
  case "$provider" in
    anthropic)
      [[ -z "$api_key" ]] && api_key=$(jq -r '.anthropic.api_key // empty' "$SETTINGS_FILE" 2>/dev/null)
      [[ -z "$model" ]] && model=$(jq -r '.anthropic.model // empty' "$SETTINGS_FILE" 2>/dev/null)
      ;;
    gemini)
      [[ -z "$api_key" ]] && api_key=$(jq -r '.gemini.api_key // empty' "$SETTINGS_FILE" 2>/dev/null)
      [[ -z "$model" ]] && model=$(jq -r '.gemini.model // empty' "$SETTINGS_FILE" 2>/dev/null)
      ;;
    ollama)
      [[ -z "$model" ]] && model=$(jq -r '.ollama.model // empty' "$SETTINGS_FILE" 2>/dev/null)
      [[ -z "$ollama_host" ]] && ollama_host=$(jq -r '.ollama.host // empty' "$SETTINGS_FILE" 2>/dev/null)
      ;;
    openai)
      [[ -z "$api_key" ]] && api_key=$(jq -r '.openai.api_key // empty' "$SETTINGS_FILE" 2>/dev/null)
      [[ -z "$model" ]] && model=$(jq -r '.openai.model // empty' "$SETTINGS_FILE" 2>/dev/null)
      [[ -z "$openai_base_url" ]] && openai_base_url=$(jq -r '.openai.base_url // empty' "$SETTINGS_FILE" 2>/dev/null)
      ;;
  esac
fi

model="$(trim "$model")"
ollama_host="$(trim "$ollama_host")"
openai_base_url="$(trim "$openai_base_url")"
api_key="$(trim "$api_key")"
github_token="$(trim "$github_token")"

case "$provider" in
  anthropic) model="${model:-claude-sonnet-5}" ;;
  gemini)    model="${model:-gemini-2.5-flash}" ;;
  ollama)    model="${model:-qwen2.5-coder:7b}"; ollama_host="${ollama_host:-http://localhost:11434}" ;;
  # "openai" covers the real OpenAI API and any local server speaking the
  # same Chat Completions contract (LM Studio, vLLM's OpenAI server,
  # text-generation-webui, LocalAI, llama.cpp server mode, etc.) - base_url
  # is configurable rather than hardcoded for exactly that reason.
  openai)    model="${model:-gpt-4o}"; openai_base_url="${openai_base_url:-https://api.openai.com/v1}" ;;
  *) fail "Unknown provider '${provider}' (expected anthropic, gemini, ollama, or openai)" ;;
esac

# api_key isn't required for ollama (no concept of one) or openai (most
# local OpenAI-compatible servers ignore it or accept any placeholder;
# the real OpenAI API will just reject the request with a clear 401 if one
# was actually needed and missing, same as it would for a wrong key).
if [[ "$provider" != "ollama" && "$provider" != "openai" ]]; then
  [[ -n "$api_key" ]] || fail "No API key configured for ${provider}. Set it in the plugin's Settings tab."
fi

# ---------------------------------------------------------------------------
# Parse owner/repo out of the given URL. Trailing slash and .git are
# stripped via parameter expansion rather than baked into the regex below:
# `sed -E` is POSIX extended regex, which has no lazy/non-greedy quantifier,
# so a naive "[^/]+?(\.git)?/?$" doesn't actually make ".git" optional the
# way it looks like it should - it was matching greedily and leaving
# ".git" stuck in the captured repo name.
# ---------------------------------------------------------------------------
normalized_url="${repo_url%/}"
normalized_url="${normalized_url%.git}"
normalized_url="${normalized_url%/}"
owner_repo=$(echo "$normalized_url" | sed -E 's#^https?://(www\.)?github\.com/([^/]+/[^/]+)$#\2#')
[[ "$owner_repo" != "$normalized_url" && "$owner_repo" == */* ]] || fail "Could not parse a GitHub owner/repo from: $repo_url"
# Canonical form, independent of how the user typed the input (trailing
# slash, .git suffix, www.) - used for the OCI source label below.
repo_full_url="https://github.com/${owner_repo}"

gh_auth=()
[[ -n "$github_token" ]] && gh_auth=(-H "Authorization: Bearer $github_token")

gh_api() { curl -sf "${gh_auth[@]}" -H "Accept: application/vnd.github+json" "$@"; }
gh_raw_file() { curl -sf "${gh_auth[@]}" "https://raw.githubusercontent.com/${owner_repo}/${default_branch}/$1" 2>/dev/null; }
# READMEs and env-var docs routinely run 30-50KB on well-documented repos
# (the whole point of this tool); truncating at a few KB silently drops the
# actual docker-run/.env sections. Budget generously - Claude/Gemini's
# context windows comfortably fit this (a small local Ollama model's
# default context may not - that's a tradeoff of that provider, not
# something to shrink this budget over for everyone else).
trunc() { head -c 60000; }

# No -f here specifically: a plain curl -sf failure on this call used to
# get reported as a flat "repo not found", which is actively misleading
# when the real cause is GitHub's unauthenticated rate limit (60 req/hour)
# - that sends someone hunting for a typo in the URL instead of adding the
# optional GitHub token in Settings. Checking the status/body distinguishes
# the two.
repo_meta_file=$(mktemp)
repo_meta_status=$(curl -s "${gh_auth[@]}" -H "Accept: application/vnd.github+json" -o "$repo_meta_file" -w '%{http_code}' "https://api.github.com/repos/${owner_repo}")
repo_meta=$(cat "$repo_meta_file" 2>/dev/null)
rm -f "$repo_meta_file"
if [[ "$repo_meta_status" != "200" ]]; then
  gh_message=$(echo "$repo_meta" | jq -r '.message // empty' 2>/dev/null)
  if [[ "$repo_meta_status" == "403" || "$repo_meta_status" == "429" ]] && echo "$gh_message" | grep -qi "rate limit"; then
    token_hint="Set a GitHub token in the plugin's Settings tab to raise this limit."
    [[ -n "$github_token" ]] && token_hint="The configured GitHub token doesn't appear to have raised it - double-check it in Settings."
    fail "GitHub API rate limit exceeded. ${token_hint}"
  fi
  fail "GitHub repo not found or inaccessible: ${owner_repo} (HTTP ${repo_meta_status}${gh_message:+: ${gh_message}})"
fi
default_branch=$(echo "$repo_meta" | jq -r '.default_branch // "main"')

# Full recursive tree, not just the root listing - Dockerfiles, compose
# files, and .env examples are routinely nested (docker/, example/, deploy/).
repo_tree=$(gh_api "https://api.github.com/repos/${owner_repo}/git/trees/${default_branch}?recursive=1" | jq -r '.tree[]? | select(.type=="blob") | .path' 2>/dev/null)
find_file() {
  # $1 = case-insensitive regex; prefers the shallowest path, then shortest.
  echo "$repo_tree" | grep -iE "$1" | awk '{print gsub(/\//,"/"), length, $0}' | sort -n | head -1 | cut -d' ' -f3-
}

repo_slug="${owner_repo##*/}"
compose_candidates=$(echo "$repo_tree" | grep -iE '(^|/)(docker-)?compose\.ya?ml$')
# Repos with multiple example stacks (e.g. example/<app>/, example/smtp/,
# example/traefik/) can have several compose.yaml files - prefer the one
# whose path actually names this app over an unrelated sidecar example.
compose_path=$(echo "$compose_candidates" | grep -iF "$repo_slug" | head -1)
if [[ -z "$compose_path" ]]; then
  compose_path=$(echo "$compose_candidates" | awk '{print gsub(/\//,"/"), length, $0}' | sort -n | head -1 | cut -d' ' -f3-)
fi
dockerfile_path=$(find_file '(^|/)dockerfile$')
# Prefer a documented example (.env.example/.env.sample) over a real .env,
# since a real .env in a repo (rare, but possible) may hold live secrets.
env_path=$(find_file '(^|/)\.env\.(example|sample)$')
[[ -n "$env_path" ]] || env_path=$(find_file '(^|/)\.env$')

readme_t=$(gh_api -H "Accept: application/vnd.github.raw" "https://api.github.com/repos/${owner_repo}/readme" 2>/dev/null | trunc)
compose_t=""
[[ -n "$compose_path" ]] && compose_t=$(gh_raw_file "$compose_path" | trunc)
dockerfile_t=""
[[ -n "$dockerfile_path" ]] && dockerfile_t=$(gh_raw_file "$dockerfile_path" | trunc)
env_t=""
[[ -n "$env_path" ]] && env_t=$(gh_raw_file "$env_path" | trunc)

[[ -n "$readme_t$compose_t$dockerfile_t$env_t" ]] || fail "No README, Dockerfile, compose file, or .env example found in ${owner_repo}"

# ---------------------------------------------------------------------------
# Few-shot schema examples, baked into the script (only this file is copied
# onto the MOS host, so it can't read the repo's samples/ dir at runtime).
# ---------------------------------------------------------------------------
docker_schema_example=$(cat <<'EOF'
{
  "name": "Jellyfin",
  "repo": "lscr.io/linuxserver/jellyfin:latest",
  "network": "bridge",
  "extra_parameters": "--restart=unless-stopped",
  "web_ui_url": "http://[IP]:[PORT:8096]/",
  "icon": "",
  "description": "Media server for streaming your library.",
  "paths": [
    { "name": "Data Path", "mode": "", "host": "/mnt/cache/AppData/jellyfin/config", "container": "/config", "description": "" }
  ],
  "ports": [
    { "name": "http - WebGUI", "protocol": "tcp", "host": "8096", "container": "8096", "description": "" }
  ],
  "variables": [
    { "name": "PUID", "key": "PUID", "value": "500", "mask": false, "description": "" }
  ],
  "devices": [],
  "labels": [],
  "no_autoupdate": false,
  "privileged": false
}
EOF
)

compose_schema_example=$(cat <<'EOF'
{
  "mode": "compose",
  "name": "immich",
  "yaml": "services:\n  immich-server:\n    image: ghcr.io/immich-app/immich-server:release\n    ports:\n      - \"2283:2283\"\n    volumes:\n      - ./immich-server/upload:/usr/src/app/upload\n    labels:\n      org.opencontainers.image.source: https://github.com/immich-app/immich\n  immich-redis:\n    image: redis:6.2-alpine\n    volumes:\n      - ./immich-redis/data:/data\n",
  "env": "TZ=UTC\nDB_PASSWORD=changeme\n",
  "template": {
    "name": "Immich",
    "description": "Self-hosted photo and video backup solution.",
    "icon": "",
    "webui": "http://{IP}:2283",
    "category": ["Media"]
  }
}
EOF
)

# ---------------------------------------------------------------------------
# Ask the model to produce one strict-JSON object matching one of the two
# shapes above. Whether this is a single-container ("docker") or
# multi-service ("compose") app is the model's call, based on the actual
# services it sees.
# ---------------------------------------------------------------------------
if [[ "$scope" == "required" ]]; then
  scope_purpose="The point of this template is to let someone get this
self-hosted service running with the least amount of setup: it should
include only what the app actually needs to start - required variables,
its essential config/data paths, its main service port(s) - and leave out
everything optional or advanced, even if the docs mention it."
  scope_rule="- Include ONLY paths/ports that are required for the app to
  run: the docs mark them Required, or the app has no usable default and
  won't start without them. Omit optional/advanced ones entirely - the
  goal here is the smallest working template, not an exhaustive one.
  Variables follow a mode-specific rule instead of plain omission:
  - docker mode: omit optional/advanced entries from the \"variables\"
    array entirely, same as paths/ports above - there's no way to
    represent an inactive-but-present entry there.
  - compose mode: do NOT omit optional/advanced variables from \"env\".
    Include them as commented-out lines instead - a leading \"#\" before
    the same key and its example/default value, e.g.
    \"#REDIS_PASSWORD=changeme\" - so the user can see what exists and
    uncomment what they need without hunting the docs. Required
    variables still get normal, uncommented \"KEY=value\" lines."
else
  scope_purpose="The point of this template is to let someone try out a new
self-hosted service without typing or copy-pasting config by hand: it
should arrive with every setting they might plausibly need already present
(with a sensible default, or blank with a description) so they only ever
have to delete what they don't want, never hunt down and add something
that's missing."
  scope_rule="- Include every variable you find - optional/advanced ones
  included. Do NOT prune down to a \"required only\" subset; a long list
  the user can delete from is correct, a short list they'd have to add to
  is not."
fi

system_prompt=$(cat <<EOF
You turn a software project's install docs into a MOS (mos-official.net) app
template. ${scope_purpose} MOS templates come in two shapes:

1) "docker" mode - for a single-container app (a plain \`docker run\`, or a
   compose file with exactly one service). Output shape (see example):
${docker_schema_example}

2) "compose" mode - for a multi-service app (a compose file with 2+
   services that must run together). Output shape (see example):
${compose_schema_example}

Rules:
- "name" ("docker.name" in docker mode, top-level "name" in compose mode)
  is a literal Docker container/stack identifier, not a display title -
  Docker rejects anything outside [a-zA-Z0-9][a-zA-Z0-9_.-]*. Use a
  lowercase-hyphenated slug of the app's name (e.g. "github-release-monitor",
  not "GitHub Release Monitor"). In compose mode this is separate from
  "template.name", which is the human-readable display title and can keep
  spaces/capitalization normally.
- Prefer "docker" mode whenever the app only truly needs one container to
  run standalone. If the repo documents more than one deployment method
  (e.g. a plain \`docker run\` AND a docker-compose example that adds a
  reverse proxy, external networks, or optional sidecar containers like a
  mailer), prefer the simplest self-contained one - don't drag in
  infrastructure that isn't required just because a compose example
  showed it as an option.
- If a \`docker run\` command uses \`--env-file\`, the actual environment
  variables are NOT in that command - they're in the .env/.env.example
  file provided below (if any). Treat that file as the authoritative
  variable list: one \`variables\` entry per key found in it. Use the
  comment immediately above each key as its "description", and its
  example/default value as "value" (blank placeholders like "" or
  "changeme" stay blank/placeholder - don't invent a real-looking secret).
${scope_rule}
- Set "mask": true for any variable that is a password, token, secret, or
  API key.
- Note in each such variable's description when the README marks it
  Required vs optional, and any stated constraints (e.g. "min 32 chars").
- Use real values from the provided README/Dockerfile/compose/env
  content: the actual image tag, actual ports, actual container-side
  volume paths. Do not invent ports or container paths that aren't
  evidenced in the input. In particular, do NOT default to a framework's
  usual port (e.g. 3000 for Node.js, 8080 for a generic web app) - if a
  Dockerfile's EXPOSE/ENV PORT, a compose file's ports mapping, or the
  README states a specific port, use that exact number even if it's an
  unusual choice.
- Host-side paths follow different conventions per mode, and this
  overrides whatever host path the repo's own docs happen to show
  (they're written for the repo author's machine, not this one):
  - compose mode: every volume's host side must be a RELATIVE path in
    the form "./<service-name>/<subpath>" (see the example's
    "./immich-server/upload" and "./immich-redis/data" - one subfolder
    per service so they don't collide). Never an absolute path like
    /mnt/... here - MOS runs each stack from a working directory that's
    already inside the real configured appdata location, so a relative
    path always lands in the right place regardless of what that host's
    appdata pool is actually called.
  - docker mode: use the literal placeholder /mnt/cache/appdata/<app>/<name>
    for any host path you must invent (e.g. a config volume with no host
    path specified upstream). This placeholder gets rewritten to the
    real configured appdata path automatically.
- The template must carry a standard OCI image label
  (https://github.com/opencontainers/image-spec/blob/main/annotations.md)
  linking back to the project: "org.opencontainers.image.source" set to
  the exact "Repository URL" given below. In docker mode, do NOT add this
  yourself - the "labels" array in the output shape is for the app's own
  labels (if any), and the analyze script adds the source label for you
  automatically. In compose mode there is no such post-processing, so you
  must add it directly - but compose has no stack-wide/document-level
  labels field, only per-service ones, so add a "labels:" section with
  "org.opencontainers.image.source: <Repository URL>" to exactly ONE
  service: the primary one actually running the application (e.g.
  "immich-server" in the example below), never to sidecars like a
  database or cache (e.g. not "immich-redis"). One label for the whole
  stack, not one per service.
- web_ui_url / webui must use the literal placeholder tokens shown in the
  examples ([IP], [PORT:xxxx], {IP}) - do not guess a real IP. Use the
  container port (not the example host port) in [PORT:xxxx].
- Leave "icon" as an empty string - it is resolved separately.
- Respond with ONLY the single JSON object. No markdown fences, no prose.
EOF
)

user_content=$(cat <<EOF
Repository: ${owner_repo}
Repository URL: ${repo_full_url}

README (may be truncated):
${readme_t}

Dockerfile (may be truncated, may be absent):
${dockerfile_t}

Compose file (may be truncated, may be absent):
${compose_t}

.env / .env.example file (may be truncated, may be absent - authoritative
source of environment variables when a docker run command uses --env-file):
${env_t}
EOF
)

# Each provider fills the shared $raw_text with the model's answer (a JSON
# string, possibly fenced) and fail()s itself on any error/truncation.
budget=8192

# Ollama-only: the request context window. Anthropic/Gemini have context
# windows large enough that the truncation budget above "comfortably fits"
# (see trunc()'s comment) without any extra configuration; Ollama has no
# such guarantee and, left unset, silently falls back to whatever a given
# model's Modelfile defaults to - commonly just 2048-4096 tokens for many
# pulled models. The system prompt alone runs ~1,200 tokens, and a single
# real-world README can be 30-50KB (~7,500-12,500 tokens) before even
# adding a Dockerfile/compose/env file on top - well past a default that
# small, silently truncating away the very content this whole prompt is
# built around. 16384 comfortably covers a typical repo's worth of input
# plus a large generated template; if a specific model/repo still needs
# more, this is the one place to raise it.
ollama_num_ctx=16384

# claude-sonnet-5 runs adaptive extended thinking by default, which prepends
# a "thinking" content block before the "text" block - max_tokens covers
# both, and content[0] is the thinking block, not the answer. Request
# medium effort (this is single-shot extraction, not agentic reasoning -
# doesn't need "high") and budget enough tokens for both a real thinking
# pass and a large, comprehensive template (36+ variables is normal - see
# the comprehensiveness rule above), well within MOS's 60s query timeout.
call_anthropic() {
  local request_body response stop_reason
  request_body=$(jq -n \
    --arg model "$model" --argjson budget "$budget" \
    --arg system "$system_prompt" --arg user "$user_content" \
    '{
      model: $model,
      max_tokens: $budget,
      thinking: {type: "adaptive"},
      output_config: {effort: "medium"},
      system: $system,
      messages: [{role:"user", content:$user}]
    }')

  response=$(curl -sf \
    -H "x-api-key: ${api_key}" \
    -H "anthropic-version: 2023-06-01" \
    -H "content-type: application/json" \
    -d "$request_body" \
    "https://api.anthropic.com/v1/messages") || fail "Claude API request failed"

  stop_reason=$(echo "$response" | jq -r '.stop_reason // empty')
  # Content is an array of typed blocks (thinking, text, ...) - find the text
  # block instead of assuming index 0.
  raw_text=$(echo "$response" | jq -r '[.content[]? | select(.type == "text") | .text] | join("")')
  [[ -n "$raw_text" ]] || fail "Claude returned no content (stop_reason: ${stop_reason:-unknown}): $(echo "$response" | jq -c '.error // .' 2>/dev/null)"
  [[ "$stop_reason" != "max_tokens" ]] || fail "Claude's response was truncated (hit the token limit) before finishing the template"
}

# Gemini's free API tier - responseMimeType forces strict JSON, so no
# fence-stripping is needed for this path (harmless if it stays anyway).
call_gemini() {
  local request_body response finish_reason
  request_body=$(jq -n \
    --argjson budget "$budget" \
    --arg system "$system_prompt" --arg user "$user_content" \
    '{
      system_instruction: {parts: [{text: $system}]},
      contents: [{role: "user", parts: [{text: $user}]}],
      generationConfig: {responseMimeType: "application/json", maxOutputTokens: $budget}
    }')

  response=$(curl -sf \
    -H "content-type: application/json" \
    -d "$request_body" \
    "https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${api_key}") \
    || fail "Gemini API request failed"

  finish_reason=$(echo "$response" | jq -r '.candidates[0].finishReason // empty')
  raw_text=$(echo "$response" | jq -r '.candidates[0].content.parts[0].text // empty')
  [[ -n "$raw_text" ]] || fail "Gemini returned no content (finishReason: ${finish_reason:-unknown}): $(echo "$response" | jq -c '.error // .' 2>/dev/null)"
  [[ "$finish_reason" != "MAX_TOKENS" ]] || fail "Gemini's response was truncated (hit the token limit) before finishing the template"
}

# Local model via Ollama - no API key, but no vendor safety net either:
# small local models are noticeably less reliable at holding this whole
# schema together than Claude/Gemini, and there's no billing wall to hide
# a slow first-token cold start behind MOS's 60s query timeout.
call_ollama() {
  local request_body response
  # Fail fast if the host isn't reachable at all, rather than waiting on
  # curl's default (very long, sometimes minutes) connect behavior on the
  # real generation request below - that request has no timeout of its
  # own since a real analysis can legitimately take a while on this
  # provider (see ai-template-maker-analyze-start), so an unreachable host
  # would otherwise just hang instead of failing. This same /api/tags call
  # also resolves the configured model against what's actually pulled
  # (see below), so it isn't purely a reachability probe.
  local tags_response tags_err
  tags_response=$(curl -sf --connect-timeout 5 --max-time 10 "${ollama_host%/}/api/tags" 2>&1)
  local tags_exit=$?
  [[ $tags_exit -eq 0 ]] \
    || fail "Could not reach Ollama at ${ollama_host} (curl exit ${tags_exit}${tags_response:+: ${tags_response}}) - is it running and reachable from the MOS host?"

  # Ollama's real /api/chat endpoint needs an exact model tag (a bare
  # "qwen2.5-coder" only resolves if a ":latest" tag happens to exist) -
  # using whatever string is configured verbatim can pass the Settings
  # tab's lenient test (see ai-template-maker-test-ollama) yet still get
  # rejected here with an opaque HTTP error. Resolve to the exact matched
  # tag up front instead, with the same exact-or-prefix matching the test
  # uses, so anything that passes that test is guaranteed to also work.
  local resolved_model
  resolved_model=$(echo "$tags_response" | jq -r --arg m "$model" '
    [.models[]? | (.name // .model // "")] |
    (map(select(. == $m)) + map(select(startswith($m + ":")))) | first // empty
  ')
  if [[ -z "$resolved_model" ]]; then
    local available
    available=$(echo "$tags_response" | jq -r '[.models[]? | (.name // .model // empty)] | join(", ")')
    fail "Configured Ollama model '${model}' is not pulled on ${ollama_host}. Available: ${available:-none} - pull it (ollama pull ${model}) or fix the model name in Settings."
  fi
  model="$resolved_model"

  request_body=$(jq -n \
    --arg model "$model" --argjson num_ctx "$ollama_num_ctx" \
    --arg system "$system_prompt" --arg user "$user_content" \
    '{
      model: $model,
      stream: false,
      format: "json",
      options: {num_ctx: $num_ctx},
      messages: [{role:"system", content:$system}, {role:"user", content:$user}]
    }')

  # No -f here: on an HTTP error, Ollama's body is a {"error":"..."}
  # message worth surfacing directly rather than discarding (which is
  # exactly what happened before this model-resolution step existed - a
  # bare "curl exit 22" with no indication it was a 404 for a mistyped tag).
  local http_status response_file
  response_file=$(mktemp)
  http_status=$(curl -s --max-time 0 -o "$response_file" -w '%{http_code}' \
    -H "content-type: application/json" \
    -d "$request_body" \
    "${ollama_host%/}/api/chat")
  local curl_rc=$?
  response=$(cat "$response_file" 2>/dev/null)
  rm -f "$response_file"

  [[ $curl_rc -eq 0 ]] \
    || fail "Generation request failed: could not reach Ollama at ${ollama_host} (curl exit ${curl_rc}) - passed the reachability/model check moments earlier, so this is likely the connection dropping mid-request."
  if [[ "$http_status" != "200" ]]; then
    local ollama_err
    ollama_err=$(echo "$response" | jq -r '.error // empty' 2>/dev/null)
    fail "Ollama returned HTTP ${http_status} for the generation request${ollama_err:+: ${ollama_err}}"
  fi

  raw_text=$(echo "$response" | jq -r '.message.content // empty')
  [[ -n "$raw_text" ]] || fail "Ollama returned no content: $(echo "$response" | jq -c '.error // .' 2>/dev/null)"
}

# OpenAI-compatible: the real OpenAI API, or any local server speaking the
# same Chat Completions contract (see openai_base_url's default-assignment
# comment above for the list). api_key is optional here - most local
# servers ignore it or accept any placeholder.
call_openai() {
  local request_body response
  local auth_header=()
  [[ -n "$api_key" ]] && auth_header=(-H "Authorization: Bearer ${api_key}")

  # Best-effort model resolution against what the server actually reports -
  # unlike Ollama's hard-fail on a mismatch, this falls back to using the
  # configured name verbatim on any hiccup, since "OpenAI-compatible" covers
  # too wide a range of servers to trust every /models response equally.
  # A genuinely wrong name still surfaces clearly via the real request's
  # own error response below, same as it always would have.
  local models_response models_exit
  models_response=$(curl -sf --connect-timeout 5 --max-time 10 "${auth_header[@]}" "${openai_base_url%/}/models" 2>&1)
  models_exit=$?
  if [[ $models_exit -eq 0 ]]; then
    local resolved
    resolved=$(echo "$models_response" | jq -r --arg m "$model" '[.data[]? | .id] | map(select(. == $m)) | first // empty' 2>/dev/null)
    [[ -n "$resolved" ]] && model="$resolved"
  else
    fail "Could not reach ${openai_base_url} (curl exit ${models_exit}${models_response:+: ${models_response}}) - is it running and reachable from the MOS host?"
  fi

  request_body=$(jq -n \
    --arg model "$model" --argjson budget "$budget" \
    --arg system "$system_prompt" --arg user "$user_content" \
    '{
      model: $model,
      max_tokens: $budget,
      response_format: {type: "json_object"},
      messages: [{role:"system", content:$system}, {role:"user", content:$user}]
    }')

  # No -f here, same reasoning as Ollama's generation request: on an HTTP
  # error the body is a {"error":{"message":"..."}} worth surfacing
  # directly rather than discarding.
  local http_status response_file
  response_file=$(mktemp)
  http_status=$(curl -s "${auth_header[@]}" -o "$response_file" -w '%{http_code}' \
    -H "content-type: application/json" \
    -d "$request_body" \
    "${openai_base_url%/}/chat/completions")
  local curl_rc=$?
  response=$(cat "$response_file" 2>/dev/null)
  rm -f "$response_file"

  [[ $curl_rc -eq 0 ]] \
    || fail "Generation request failed: could not reach ${openai_base_url} (curl exit ${curl_rc}) - passed the reachability/model check moments earlier, so this is likely the connection dropping mid-request."
  if [[ "$http_status" != "200" ]]; then
    local api_err
    api_err=$(echo "$response" | jq -r '.error.message // empty' 2>/dev/null)
    fail "OpenAI-compatible server returned HTTP ${http_status} for the generation request${api_err:+: ${api_err}}"
  fi

  raw_text=$(echo "$response" | jq -r '.choices[0].message.content // empty')
  [[ -n "$raw_text" ]] || fail "OpenAI-compatible server returned no content: $(echo "$response" | jq -c '.error // .' 2>/dev/null)"
}

case "$provider" in
  anthropic) call_anthropic ;;
  gemini)    call_gemini ;;
  ollama)    call_ollama ;;
  openai)    call_openai ;;
esac

# Strip stray markdown fences if the model added them despite instructions.
json_text=$(echo "$raw_text" | sed -E '/^```/d')

echo "$json_text" | jq empty 2>/dev/null || fail "The ${provider} model did not return valid JSON"

# ---------------------------------------------------------------------------
# Icon resolution: selfh.st/icons, then dashboard-icons, by slugified name.
# ---------------------------------------------------------------------------
slugify() { echo "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'; }

resolve_icon() {
  local slug
  slug=$(slugify "$1")
  [[ -n "$slug" ]] || return 0
  local candidates=(
    "https://cdn.jsdelivr.net/gh/selfhst/icons@main/png/${slug}.png"
    "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons@main/png/${slug}.png"
  )
  local url
  for url in "${candidates[@]}"; do
    if curl -sfIL --max-time 5 "$url" >/dev/null 2>&1; then
      echo "$url"
      return 0
    fi
  done
}

# Docker container/stack names must match [a-zA-Z0-9][a-zA-Z0-9_.-]* - the
# system prompt tells the model this, but don't rely on it complying (seen in
# practice: "GitHub Release Monitor" instead of "github-release-monitor",
# which the Docker daemon rejects outright at creation time). slugify()
# already produces a safe charset; just guard against an all-symbols input
# collapsing to an empty/invalid string.
sanitize_name() {
  local slug
  slug=$(slugify "$1")
  echo "${slug:-app}"
}

# ---------------------------------------------------------------------------
# Docker mode host paths: the model is told to invent /mnt/cache/appdata/...
# placeholders (mirroring MOS's own Hub template convention - see
# hub.service.js's _remapAppdataPaths, which does this same rewrite for
# templates fetched through MOS's own Hub browser). mos-deploy_docker only
# performs this rewrite when explicitly invoked with an "override_appdata"
# argument, which the plain REST create call we use never passes - so
# without doing it ourselves, an invented placeholder would get created
# completely literally, landing on whatever pool is literally named "cache"
# (or nothing at all, on a system that doesn't have one). This script runs
# directly on the MOS host, so it can read the box's actual configured
# appdata path from the same file mos-deploy_docker itself reads
# (/boot/config/docker.json) and apply the same substitution
# mos-deploy_docker's override_appdata mode does: replace everything up
# through the first "/appdata/" with the real configured path.
# ---------------------------------------------------------------------------
remap_appdata_paths() {
  local real_appdata
  real_appdata=$(jq -r '.appdata // empty' /boot/config/docker.json 2>/dev/null)
  [[ -n "$real_appdata" ]] || return 0
  json_text=$(echo "$json_text" | jq --arg appdata "${real_appdata%/}" '
    if (.docker.paths | type) == "array" then
      .docker.paths |= map(
        if ((.host // "") | test("/appdata/")) then
          .host = ($appdata + "/" + ((.host) | sub(".*?/appdata/"; "")))
        else . end
      )
    else . end
  ')
}

# Standard OCI image annotation for "URL to get source code for building the
# image" (https://github.com/opencontainers/image-spec/blob/main/annotations.md)
# - added deterministically rather than trusting the model with the URL, since
# we already know it exactly. Idempotent: drops any entry the model added
# under this key first, so re-running never duplicates it.
add_source_label() {
  json_text=$(echo "$json_text" | jq --arg url "$repo_full_url" '
    .docker.labels = (
      [{name: "Image Source", key: "org.opencontainers.image.source", value: $url, mask: false, description: "Links back to the GitHub repository this template was generated from."}]
      + ((.docker.labels // []) | map(select(.key != "org.opencontainers.image.source")))
    )
  ')
}

# ---------------------------------------------------------------------------
# History: best-effort append of {repo, url, mode, scope, provider, model,
# result, analyzed_at} to HISTORY_FILE, newest first, capped at 100 entries.
# Storing the full result (not just its metadata) lets the History tab
# reopen a past analysis in the install dialog without re-running it -
# results are small enough (a JSON template, typically a few KB) that
# embedding them directly is simpler than a separate per-entry file. Never
# fails the analysis itself - the Analyze tab's whole point still worked
# even if this didn't. flock guards the read-modify-write against a second
# concurrent analyze call; bin/ai-template-maker-history serves this file
# back to the frontend's History tab.
# ---------------------------------------------------------------------------
append_history() {
  local repo="$1" mode="$2" scope="$3" url="$4" prov="$5" mdl="$6" result_json="$7"
  local hist_dir=""
  hist_dir=$(dirname "$HISTORY_FILE")
  mkdir -p "$hist_dir" 2>/dev/null || return 0
  [[ -f "$HISTORY_FILE" ]] || echo '[]' > "$HISTORY_FILE" 2>/dev/null || return 0
  (
    flock -w 5 -x 200 || exit 0
    local entry current updated
    entry=$(jq -n --arg repo "$repo" --arg url "$url" --arg mode "$mode" --arg scope "$scope" \
      --arg provider "$prov" --arg model "$mdl" --argjson result "$result_json" \
      --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      '{repo:$repo, url:$url, mode:$mode, scope:$scope, provider:$provider, model:$model, result:$result, analyzed_at:$at}')
    current=$(cat "$HISTORY_FILE" 2>/dev/null)
    jq empty <<<"$current" >/dev/null 2>&1 || current='[]'
    updated=$(jq --argjson entry "$entry" '[$entry] + . | .[0:100]' <<<"$current" 2>/dev/null)
    [[ -n "$updated" ]] && echo "$updated" > "$HISTORY_FILE"
  ) 200>"${HISTORY_FILE}.lock" 2>/dev/null
}

mode=$(echo "$json_text" | jq -r '.mode // "docker"')
if [[ "$mode" == "compose" ]]; then
  raw_name=$(echo "$json_text" | jq -r '.name // "app"')
  safe_name=$(sanitize_name "$raw_name")
  json_text=$(echo "$json_text" | jq --arg name "$safe_name" '.name = $name')
  app_name=$(echo "$json_text" | jq -r '.template.name // .name')
  icon_url=$(resolve_icon "$app_name")
  final_json=$(echo "$json_text" | jq --arg icon "${icon_url:-}" '.template.icon = $icon')
else
  # Wrap bare docker-shaped output for consistency, in case the model
  # omitted the {"mode":"docker","docker":{...}} envelope.
  has_docker_key=$(echo "$json_text" | jq 'has("docker")')
  if [[ "$has_docker_key" != "true" ]]; then
    json_text=$(jq -n --argjson d "$json_text" '{mode:"docker", docker:$d}')
  fi
  raw_name=$(echo "$json_text" | jq -r '.docker.name // "app"')
  safe_name=$(sanitize_name "$raw_name")
  json_text=$(echo "$json_text" | jq --arg name "$safe_name" '.docker.name = $name')
  remap_appdata_paths
  add_source_label
  app_name=$(echo "$json_text" | jq -r '.docker.name')
  icon_url=$(resolve_icon "$app_name")
  final_json=$(echo "$json_text" | jq --arg icon "${icon_url:-}" '.docker.icon = $icon')
fi

append_history "$owner_repo" "$mode" "$scope" "$repo_url" "$provider" "$model" "$final_json"
echo "$final_json"
